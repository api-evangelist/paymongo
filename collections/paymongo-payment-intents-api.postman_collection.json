          "name": "Create a Payment Intent",
          "request": {
            "name": "Create a Payment Intent",
            "description": {
              "content": "Creates a Payment Intent that tracks the lifecycle of a payment. Uses the secret API key. Amount is an integer in centavos (minimum 2000 = PHP 20.00 for most methods).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "payment_intents"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
