              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"attributes\": {\n      \"amount\": \"<integer>\",\n      \"payment_method_allowed\": [\n        \"<string>\",\n        \"<string>\"\n      ],\n      \"currency\": \"<string>\",\n      \"capture_type\": \"automatic\",\n      \"description\": \"<string>\",\n      \"statement_descriptor\": \"<string>\",\n      \"metadata\": {\n        \"key_0\": true\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
